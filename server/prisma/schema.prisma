generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Spot {
  id          String   @id @default(cuid())
  title       String
  place       String   @default("")
  description String   @default("")
  author      String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Repair {
  id          String        @id @default(cuid())
  title       String
  place       String        @default("")
  description String        @default("")
  author      String        @default("")
  status      String        @default("pending")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  photos      RepairPhoto[]
}

model RepairPhoto {
  id        String   @id @default(cuid())
  repairId  String
  fileName  String
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  repair    Repair   @relation(fields: [repairId], references: [id], onDelete: Cascade)

  @@index([repairId])
}

model Notice {
  id        String   @id @default(cuid())
  title     String
  body      String   @default("")
  author    String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vote {
  id            String       @id @default(cuid())
  title         String
  body          String       @default("")
  author        String       @default("")
  startsAt      DateTime     @default(now())
  endsAt        DateTime
  allowMultiple Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  options       VoteOption[]
  ballots       VoteBallot[]
}

model VoteOption {
  id      String       @id @default(cuid())
  label   String
  count   Int          @default(0)
  voteId  String
  vote    Vote         @relation(fields: [voteId], references: [id], onDelete: Cascade)
  ballots VoteBallot[]

  @@index([voteId])
}

model VoteBallot {
  id        String     @id @default(cuid())
  voteId    String
  optionId  String
  voterKey  String
  name      String
  createdAt DateTime   @default(now())
  vote      Vote       @relation(fields: [voteId], references: [id], onDelete: Cascade)
  option    VoteOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([voteId, optionId, voterKey])
  @@index([voteId, voterKey])
  @@index([optionId])
}

model Model3d {
  id          String        @id @default(cuid())
  title       String
  format      String        @default("")
  fileName    String        @default("")
  url         String        @default("")
  description String        @default("")
  author      String        @default("")
  pinHash     String        @default("")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  files       Model3dFile[]
}

model Model3dFile {
  id        String   @id @default(cuid())
  modelId   String
  fileName  String   @default("")
  format    String   @default("")
  createdAt DateTime @default(now())
  model     Model3d  @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@index([modelId])
}

model PushToken {
  id        String   @id @default(cuid())
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GameScore {
  id        String   @id @default(cuid())
  name      String   @unique
  score     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([score])
}
